<!DOCTYPE html>
<html lang="es-AR">
<head>
<%- include('../partials/meta-tags', {
  title: "Daniel - Mis 50",
  description: "Te invito a celebrar mis 50 años. Sábado 21 de noviembre, 21:30 hs. Confirmá tu presencia.",
  url: "https://tudiaespecial.com/daniel-50",
  image: "https://tudiaespecial.com/images/events/daniel-50/hero-daniel-gold-v1.webp",
  type: "article"
}) %>
<meta name="theme-color" content="#000000">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Jost:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root { color-scheme: dark; --gold:#ddb967; --light:#fae8b1; --ink:#000; --text:#f5eee0; --muted:#c5bba8; --line:rgba(221,185,103,.3); }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:#17181a; color:var(--text); font-family:"Jost",sans-serif; }
  button,input,select,textarea { font:inherit; }
  button,a,input,select,textarea,summary { -webkit-tap-highlight-color:transparent; }
  .invitation { position:relative; max-width:580px; margin:0 auto; padding:0 22px 36px; overflow:hidden; background:#000; }
  .hero { margin:0 -22px; padding-bottom:20px; text-align:center; }
  .hero-art { display:block; width:100%; height:auto; aspect-ratio:2/3; object-fit:contain; background:#000; -webkit-mask-image:linear-gradient(to bottom,#000 0 62%,rgba(0,0,0,.94) 70%,rgba(0,0,0,.62) 80%,rgba(0,0,0,.2) 90%,transparent 99%); mask-image:linear-gradient(to bottom,#000 0 62%,rgba(0,0,0,.94) 70%,rgba(0,0,0,.62) 80%,rgba(0,0,0,.2) 90%,transparent 99%); }
  .hero-divider { position:relative; height:1px; margin:0 0 29px; background:linear-gradient(90deg,rgba(221,185,103,.04),rgba(221,185,103,.25),rgba(221,185,103,.04)); }
  .hero-divider::after { content:""; position:absolute; top:-3px; left:calc(50% - 3px); width:6px; height:6px; background:rgba(239,212,141,.4); transform:rotate(45deg); }
  .hero-date { position:relative; margin:0 auto; padding:0 18px; display:flex; align-items:center; justify-content:center; gap:16px; }
  .hero-day { font:500 4.8rem/.85 "Cormorant Garamond",serif; color:var(--light); text-shadow:0 0 24px rgba(228,188,95,.28); }
  .hero-date-copy { text-align:left; padding-left:16px; border-left:1px solid var(--gold); font-size:1rem; line-height:1.5; }
  .hero-date-copy span { display:block; }
  .hero-date-copy .month { color:var(--light); font-size:1.35rem; }
  .hero-welcome { margin:24px 10px 0; font:italic 500 1.75rem/1.1 "Cormorant Garamond",serif; color:var(--light); }
  .countdown-section { margin:0 -22px; padding:14px 26px 40px; background:#000; text-align:center; }
  .countdown { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:5px; }
  .count-unit { border-right:1px solid var(--line); padding:5px 0; }
  .count-unit:last-child { border:0; }
  .count-value { display:block; font:500 2.5rem/1 "Cormorant Garamond",serif; color:var(--light); text-shadow:0 0 16px rgba(215,169,72,.25); font-variant-numeric:tabular-nums; }
  .count-name { display:block; font-size:.63rem; color:var(--muted); margin-top:6px; text-transform:uppercase; }
  .section { position:relative; margin:0 -22px; padding:49px 26px 47px; background:#020202; text-align:center; }
  .section:nth-of-type(odd) { background:#0c0c0c; }
  .section::before { content:""; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,rgba(221,185,103,.04),rgba(221,185,103,.25),rgba(221,185,103,.04)); }
  .section::after { content:""; position:absolute; top:-3px; left:calc(50% - 3px); width:6px; height:6px; background:rgba(239,212,141,.4); transform:rotate(45deg); }
  .section-heading { margin-bottom:29px; }
  .section-icon { display:block; width:36px; height:36px; margin:0 auto 12px; color:var(--gold); filter:drop-shadow(0 0 7px rgba(232,188,87,.3)); }
  .section-icon svg { width:100%; height:100%; fill:none; stroke:currentColor; stroke-width:1.35; stroke-linecap:round; stroke-linejoin:round; }
  h2 { font:italic 500 2.7rem/1.05 "Cormorant Garamond",serif; color:var(--light); margin:0; text-shadow:0 0 12px rgba(217,174,75,.12); }
  .date-full { margin:0; font:500 1.85rem/1.2 "Cormorant Garamond",serif; }
  .event-time { color:var(--gold); font-size:1.25rem; margin:9px 0 0; }
  .venue-name { margin:0 0 5px; font:500 1.85rem/1.15 "Cormorant Garamond",serif; }
  .venue-address { margin:0 0 23px; color:var(--muted); font-size:.95rem; }
  .map-frame { overflow:hidden; border:1px solid var(--line); height:235px; background:#14130e; }
  .map-frame iframe { width:100%; height:100%; display:block; border:0; }
  .gold-button { display:inline-flex; align-items:center; justify-content:center; gap:10px; min-height:48px; padding:12px 19px; border:1px solid #e3c780; border-radius:3px; background:linear-gradient(115deg,#ba8a36,#f4daa0 50%,#c69a48); color:#211805; font-size:.88rem; font-weight:500; text-decoration:none; cursor:pointer; box-shadow:0 4px 22px rgba(190,143,47,.12); }
  .gold-button svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.7; }
  .map-button { margin-top:20px; }
  .prices { margin:0; padding:0; list-style:none; }
  .prices li { display:flex; justify-content:space-between; gap:14px; align-items:center; padding:17px 0; border-bottom:1px solid rgba(221,185,103,.17); }
  .price-label { color:var(--muted); text-align:left; font-size:.95rem; }
  .price-amount { color:var(--light); font:500 2rem/1 "Cormorant Garamond",serif; white-space:nowrap; }
  .reservation { margin:24px 0; font-size:.95rem; line-height:1.55; color:var(--muted); }
  .reservation strong { display:block; color:var(--light); font-size:1.08rem; font-weight:500; }
  .transfer details { padding:0; }
  .transfer summary { list-style:none; width:100%; }
  .transfer summary::-webkit-details-marker { display:none; }
  .transfer summary::after { content:"+"; margin-left:6px; font-size:1.2rem; }
  .transfer details[open] summary::after { content:"−"; }
  .transfer-account { margin:15px 0 0; padding:18px 10px; border:1px solid var(--line); font-size:1rem; }
  .transfer-account strong { color:var(--light); font-weight:500; }
  .section-sub { margin:12px auto 0; color:var(--muted); line-height:1.6; font-size:.97rem; }
  .rsvp-grid { display:grid; gap:20px; }
  .field { display:grid; gap:8px; min-width:0; text-align:left; }
  .field label { color:var(--light); font-size:.85rem; }
  .field input,.field select,.field textarea { width:100%; min-width:0; min-height:49px; background:#100e09; border:1px solid #5e4d2b; border-radius:3px; color:var(--text); padding:12px; font-size:1rem; }
  .field select { font-size:.88rem; }
  .field input:focus,.field select:focus,.field textarea:focus { outline:2px solid var(--gold); outline-offset:2px; }
  .field textarea { min-height:102px; resize:vertical; }
  .guest-list { display:grid; gap:24px; }
  .guest-row { margin:0; padding:22px 0 0; border:0; border-top:1px solid var(--line); display:grid; gap:15px; min-width:0; }
  .guest-number { color:var(--gold); font:italic 500 1.5rem/1 "Cormorant Garamond",serif; margin:0 0 3px; text-align:left; }
  .submit-btn { margin-top:24px; width:100%; }
  [hidden] { display:none!important; }
  .rsvp-result { text-align:center; padding:36px 0 20px; }
  .rsvp-result h3 { margin:0 0 14px; font:italic 500 2.4rem/1 "Cormorant Garamond",serif; color:var(--light); }
  .rsvp-result p { color:var(--muted); margin:0; line-height:1.6; }
  .form-error { margin:18px 0 0; color:#ffd1b0; text-align:left; }
  .spinner { display:block; width:32px; height:32px; margin:0 auto 16px; border:2px solid #544423; border-top-color:var(--light); border-radius:50%; animation:spin .8s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }
  footer { margin:0 -22px; padding:26px 22px 0; border-top:1px solid var(--line); text-align:center; color:#9d8e72; font-size:.75rem; }
  @media(min-width:760px) {
    .invitation { margin:28px auto; padding-right:36px; padding-left:36px; border:1px solid rgba(221,185,103,.34); box-shadow:0 16px 64px rgba(0,0,0,.55); }
    .hero { margin:0 -36px; }
    .countdown-section { margin:0 -36px; padding-right:42px; padding-left:42px; }
    .section { margin:0 -36px; padding:56px 42px 54px; }
    .map-frame { height:270px; }
    footer { margin:0 -36px; }
  }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } .spinner { animation:none; } }
</style>
</head>
<body>
<main class="invitation">
  <header class="hero">
    <h1 hidden>Daniel · Mis 50 años</h1>
    <img class="hero-art" src="/images/events/daniel-50/hero-daniel-gold-v1.webp" alt="Mis 50 años, Daniel, en letras doradas y confeti sobre negro" width="1024" height="1536" fetchpriority="high">
    <div class="hero-divider" aria-hidden="true"></div>
    <div class="hero-date">
      <span class="hero-day">21</span>
      <div class="hero-date-copy"><span>Sábado</span><span class="month">Noviembre</span><span>21:30 hs</span></div>
    </div>
    <p class="hero-welcome">¡Celebremos juntos!</p>
  </header>

  <section class="countdown-section" aria-label="Cuenta regresiva">
    <div class="countdown">
      <div class="count-unit"><span class="count-value" id="days">00</span><span class="count-name">Días</span></div>
      <div class="count-unit"><span class="count-value" id="hours">00</span><span class="count-name">Horas</span></div>
      <div class="count-unit"><span class="count-value" id="minutes">00</span><span class="count-name">Minutos</span></div>
      <div class="count-unit"><span class="count-value" id="seconds">00</span><span class="count-name">Segundos</span></div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 11h18M8 15h3M8 18h6"/></svg></span>
      <h2>¿Cuándo?</h2>
    </div>
    <p class="date-full">Sábado 21 de noviembre</p><p class="event-time">21:30 hs</p>
  </section>

  <section class="section">
    <div class="section-heading">
      <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
      <h2>¿Dónde?</h2>
    </div>
    <p class="venue-name">Salón Exposición</p>
    <p class="venue-address">Villa del Rosario, Córdoba</p>
    <div class="map-frame"><iframe src="https://www.google.com/maps?q=-31.5636681,-63.5460481&amp;z=16&amp;output=embed" title="Ubicación de Salón Exposición, Centro Agrotécnico Regional Villa del Rosario" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
    <a class="gold-button map-button" href="<%= event.maps_url %>" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18-6 3V6l6-3 6 3 6-3v15l-6 3-6-3ZM9 3v15M15 6v15"/></svg>Abrir Google Maps</a>
  </section>

  <section class="section">
    <div class="section-heading">
      <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4M15 15h2"/></svg></span>
      <h2>Valor de la tarjeta</h2>
    </div>
    <ul class="prices"><li><span class="price-label">Adultos</span><strong class="price-amount">$55.000</strong></li><li><span class="price-label">Niños hasta 12 años</span><strong class="price-amount">$27.500</strong></li></ul>
    <p class="reservation">Podés confirmar hasta el<strong>Viernes 20/11</strong></p>
    <div class="transfer"><details><summary class="gold-button">Ver datos para la transferencia</summary><p class="transfer-account">Alias: <strong>dseventos</strong></p></details></div>
  </section>

  <section class="section" id="rsvp">
    <div class="section-heading" id="rsvp-heading">
      <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 6l8 7 8-7M8 17l3-3M16 17l-3-3"/></svg></span>
      <h2>¿Me acompañás?</h2>
      <p class="section-sub">Confirmá hasta el viernes 20/11.</p>
    </div>
    <form action="/api/daniel-50/rsvp" method="post" id="rsvp-form">
      <input type="hidden" name="guests_json" id="guests_json">
      <div class="rsvp-grid">
        <div class="field"><label for="people_count">¿Cuántas personas?</label><input type="text" id="people_count" name="people_count" inputmode="numeric" pattern="[0-9]*" value="1" required></div>
        <div class="field"><label for="status">Asistencia</label><select id="status" name="status"><option value="confirmed">Voy / Vamos</option><option value="declined">No puedo / No podemos asistir</option></select></div>
        <div id="guest-list" class="guest-list"></div>
        <div class="field"><label for="comments">Comentarios</label><textarea id="comments" name="comments" maxlength="3000" placeholder="¿Algún comentario?"></textarea></div>
      </div>
      <p class="form-error" id="form-error" role="alert" hidden></p>
      <button class="gold-button submit-btn" type="submit">Enviar confirmación</button>
    </form>
    <div class="rsvp-result" id="rsvp-result" aria-live="polite" hidden></div>
  </section>
  <footer>Daniel · Mis 50 · 21.11.2026</footer>
</main>
<script>
(function () {
  const target = new Date("2026-11-21T21:30:00-03:00").getTime();
  function updateCountdown() {
    const diff = Math.max(0, target - Date.now());
    const values = [Math.floor(diff / 86400000), Math.floor(diff / 3600000) % 24, Math.floor(diff / 60000) % 60, Math.floor(diff / 1000) % 60];
    ["days", "hours", "minutes", "seconds"].forEach(function (id, index) { document.getElementById(id).textContent = String(values[index]).padStart(2, "0"); });
  }
  updateCountdown();
  window.setInterval(updateCountdown, 1000);

  const form = document.getElementById("rsvp-form");
  const count = document.getElementById("people_count");
  const attendance = document.getElementById("status");
  const guestList = document.getElementById("guest-list");
  const result = document.getElementById("rsvp-result");
  const heading = document.getElementById("rsvp-heading");
  const errorText = document.getElementById("form-error");
  const guestData = [];
  let sending = false;

  function snapshotGuests() {
    guestList.querySelectorAll(".guest-row").forEach(function (row, index) {
      guestData[index] = { surname: row.querySelector(".guest-surname").value, givenName: row.querySelector(".guest-given-name").value, type: row.querySelector(".guest-type").value, menu: row.querySelector(".guest-menu").value };
    });
  }
  function updateAttendance() {
    const declined = attendance.value === "declined";
    guestList.querySelectorAll(".guest-meal, .guest-type-field").forEach(function (field) { field.hidden = declined; });
    guestList.querySelectorAll(".guest-menu, .guest-type").forEach(function (select) { select.disabled = declined; });
  }
  function renderGuests() {
    snapshotGuests();
    count.value = count.value.replace(/\D/g, "");
    if (Number(count.value) > 30) count.value = "30";
    const total = Math.max(1, Number(count.value) || 1);
    guestList.replaceChildren();
    for (let index = 0; index < total; index += 1) {
      const saved = guestData[index] || { surname: "", givenName: "", type: "mayor", menu: "Menu estandar" };
      const row = document.createElement("div");
      row.className = "guest-row";
      row.innerHTML = '<p class="guest-number">Persona ' + (index + 1) + '</p>' +
        '<div class="field"><label for="surname-' + index + '">Apellido</label><input class="guest-surname" id="surname-' + index + '" type="text" maxlength="100" autocomplete="section-guest' + index + ' family-name" required pattern=".*\\S.*"></div>' +
        '<div class="field"><label for="given-' + index + '">Nombre</label><input class="guest-given-name" id="given-' + index + '" type="text" maxlength="100" autocomplete="section-guest' + index + ' given-name" required pattern=".*\\S.*"></div>' +
        '<div class="field guest-type-field"><label for="type-' + index + '">Tipo de invitación</label><select class="guest-type" id="type-' + index + '" required><option value="mayor">Mayor</option><option value="menor">Menor (hasta 12 años)</option></select></div>' +
        '<div class="field guest-meal"><label for="menu-' + index + '">Preferencia de menú</label><select class="guest-menu" id="menu-' + index + '"><option value="Menu estandar">Menu estandar</option><option value="Restricciones alimentarias (informar)">Restricciones alimentarias (informar)</option></select></div>';
      row.querySelector(".guest-surname").value = saved.surname;
      row.querySelector(".guest-given-name").value = saved.givenName;
      row.querySelector(".guest-type").value = saved.type;
      row.querySelector(".guest-menu").value = saved.menu;
      guestList.appendChild(row);
    }
    updateAttendance();
  }
  function normalizeCount() {
    count.value = String(Math.max(1, Math.min(30, Number(count.value) || 1)));
    renderGuests();
  }
  count.addEventListener("input", renderGuests);
  count.addEventListener("blur", normalizeCount);
  attendance.addEventListener("change", updateAttendance);
  renderGuests();

  form.addEventListener("submit", async function (event) {
    event.preventDefault();
    if (sending) return;
    normalizeCount();
    if (!form.reportValidity()) return;
    snapshotGuests();
    document.getElementById("guests_json").value = JSON.stringify(guestData.slice(0, Number(count.value)));
    const body = new URLSearchParams(new FormData(form));
    sending = true;
    errorText.hidden = true;
    form.hidden = true;
    heading.hidden = true;
    result.hidden = false;
    result.innerHTML = '<span class="spinner"></span><p>Guardando tu respuesta…</p>';
    try {
      const response = await fetch(form.action, { method: "POST", body, headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" } });
      const payload = await response.json();
      if (!response.ok || payload.ok !== true) throw new Error(payload.error || "No pudimos guardar tu respuesta.");
      window.setTimeout(function () {
        result.innerHTML = attendance.value === "declined"
          ? '<h3>Gracias por avisarme</h3><p>Tu respuesta quedó registrada.</p>'
          : '<h3>¡Nos vemos en la fiesta!</h3><p>Tu confirmación quedó registrada.<br>Gracias por compartir este momento conmigo.</p>';
      }, 650);
    } catch (error) {
      sending = false;
      form.hidden = false;
      heading.hidden = false;
      result.hidden = true;
      result.replaceChildren();
      errorText.textContent = error.message || "No pudimos enviar la respuesta. Intentá nuevamente.";
      errorText.hidden = false;
    }
  });
})();
</script>
</body>
</html>
