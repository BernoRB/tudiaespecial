<!DOCTYPE html>
<html lang="es-AR">
<head>
<%- include('../partials/meta-tags', {
  title: "Marta - 70 A\u00f1os",
  description: "Picu - Te invito a celebrar mis quince años",
  keywords: "invitacion digital quinces, PICU, Villa del Rosario, Cordoba, Argentina",
  description: "Marta - Te invito a celebrar mis 70 a\u00f1os",
  url: "https://tudiaespecial.com" + req.originalUrl,
  image: "https://tudiaespecial.com/images/events/marta-70/hero-invitacion.png",
  type: "article"
}) %>

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&family=Parisienne&display=swap" rel="stylesheet" />
<link rel="icon" type="image/png" href="/images/favicon.png">
<style>
  :root {
    --bg: #050505;
    --card: #101010;
    --card-soft: #15120b;
    --ink: #fffaf0;
    --muted: #ded5c2;
    --muted-strong: #f1e7d1;
    --gold: #d8b45e;
    --gold-bright: #fff0c7;
    --silver: #dce0e5;
    --gold-soft: rgba(216, 180, 94, .16);
    --line: rgba(226, 219, 204, .38);
    --shadow: 0 20px 60px rgba(216, 180, 94, .16), 0 0 26px rgba(220, 224, 229, .08);
    --glow: 0 0 8px rgba(255, 239, 202, .86), 0 0 24px rgba(216, 180, 94, .5), 0 0 52px rgba(220, 224, 229, .16);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: "Lato", sans-serif;
    color: var(--ink);
    background:
      radial-gradient(circle at 12% 0%, rgba(216, 180, 94, .25), transparent 30%),
      radial-gradient(circle at 92% 18%, rgba(220, 224, 229, .14), transparent 24%),
      radial-gradient(circle at 50% 64%, rgba(216, 180, 94, .08), transparent 38%),
      linear-gradient(135deg, #030303 0%, #0b0905 46%, #050505 100%);
  }
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .32;
    background-image:
      radial-gradient(circle at 8% 19%, #fff4c8 0 1px, transparent 2px),
      radial-gradient(circle at 83% 8%, #e4e7eb 0 1px, transparent 2px),
      radial-gradient(circle at 91% 73%, #f6d97e 0 1px, transparent 2px),
      radial-gradient(circle at 17% 84%, #e4e7eb 0 1px, transparent 2px);
    background-size: 170px 190px, 230px 210px, 260px 240px, 200px 220px;
  }
  .page {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 18px 16px 64px;
    text-align: center;
  }
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 0;
    aspect-ratio: 1135 / 1600;
    border-radius: 16px;
    border: 1px solid rgba(20, 16, 8, .82);
    box-shadow: 0 24px 72px rgba(0, 0, 0, .34), 0 0 46px rgba(216, 180, 94, .18);
    margin-bottom: 24px;
    background: #080808;
  }
  .hero-content {
    position: relative;
    z-index: 3;
    min-height: 0;
    padding: 28px 18px 36px;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
  }
  .hero-bg {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    transform: none;
    object-fit: cover;
    opacity: 1;
    filter: none;
    pointer-events: none;
  }
  .hero-date {
    font-family: "Parisienne", cursive;
    font-weight: 600;
    color: #070707;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-size: clamp(1.18rem, 5vw, 1.7rem);
    margin-bottom: 3vh;
  }
  .hero-kicker {
    font-family: "Cinzel", serif;
    font-weight: 600;
    color: #080808;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-size: clamp(.82rem, 3.5vw, 1.1rem);
    margin-bottom: 10px;
  }
  .hero-kicker,
  .hero-date {
    text-shadow:
      0 1px 0 rgba(255, 244, 198, .42),
      0 0 10px rgba(255, 226, 140, .46),
      0 0 20px rgba(190, 130, 26, .22);
  }
  .grid {
    display: grid;
    gap: 24px;
  }
  .section-card,
  .rsvp-section {
    position: relative;
    background:
      radial-gradient(circle at 100% 0%, rgba(220,224,229,.08), transparent 32%),
      linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.015)),
      var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .section-card::before,
  .rsvp-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 12%;
    right: 12%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--silver), var(--gold-bright), var(--silver), transparent);
    box-shadow: 0 0 14px rgba(255, 229, 165, .45);
  }
  .section-inner {
    padding: 40px 24px;
  }
  .section-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 20px;
    object-fit: contain;
    display: block;
    background: #050505;
    border: 2px solid rgba(234, 222, 183, .88);
    border-radius: 50%;
    padding: 8px;
    box-shadow: 0 0 20px rgba(216, 180, 94, .26), inset 0 0 12px rgba(220,224,229,.14);
  }
  .section-logo-wrap {
    position: relative;
    width: 76px;
    height: 76px;
    margin: 0 auto 18px;
    display: grid;
    place-items: center;
  }
  .section-logo,
  .section-logo-halo {
    width: 76px;
    height: 76px;
    object-fit: contain;
    display: block;
  }
  .section-logo-halo {
    position: absolute;
    inset: 0;
    opacity: .74;
    filter:
      blur(8px)
      brightness(1.55)
      saturate(1.65)
      drop-shadow(0 0 18px rgba(255, 226, 160, .85))
      drop-shadow(0 0 42px rgba(216, 180, 94, .48));
  }
  .section-logo {
    position: relative;
    z-index: 1;
    filter:
      brightness(1.12)
      saturate(1.22)
      drop-shadow(0 0 8px rgba(255, 226, 160, .64))
      drop-shadow(0 0 20px rgba(216, 180, 94, .42));
  }
  .section-title {
    font-family: "Parisienne", cursive;
    font-weight: 400;
    color: var(--gold-bright);
    text-shadow: var(--glow);
    font-size: clamp(2.1rem, 8vw, 3.1rem);
    letter-spacing: 0;
    text-transform: none;
    margin: 0 0 14px;
  }
  .section-sub {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 1.04rem;
    line-height: 1.65;
  }
  .section-divider {
    width: 86px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-bright), transparent);
    margin: 0 auto 22px;
  }
  .countdown {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 12px;
  }
  .count-box {
    border: 1px solid var(--line);
    background: linear-gradient(145deg, rgba(216,180,94,.19), rgba(220,224,229,.09));
    border-radius: 8px;
    padding: 13px 6px;
  }
  .count-number {
    display: block;
    font-family: "Cinzel", serif;
    font-weight: 700;
    color: var(--gold-bright);
    text-shadow: var(--glow);
    font-size: clamp(1.28rem, 7vw, 2.05rem);
    line-height: 1;
  }
  .count-label {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: .64rem;
    letter-spacing: .11em;
    text-transform: uppercase;
  }
  .info-list {
    display: grid;
    gap: 13px;
    color: var(--muted-strong);
    font-size: 1.08rem;
    line-height: 1.65;
  }
  .info-list strong { color: var(--ink); }
  .calendar-btn,
  .map-btn,
  .gift-toggle,
  .send-btn {
    border: 1px solid rgba(255, 239, 199, .72);
    background: linear-gradient(105deg, #a67b29 0%, #f3d983 44%, #e3e6e9 67%, #aa812d 100%);
    color: #080808;
    border-radius: 7px;
    padding: 12px 18px;
    font-family: "Cinzel", serif;
    font-weight: 700;
    font-size: .78rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    display: inline-block;
    box-shadow: 0 0 22px rgba(216, 180, 94, .24), 0 0 12px rgba(220,224,229,.13);
  }
  .calendar-btn { margin-top: 18px; }
  .map-btn { margin-top: 18px; }
  .map-wrap {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #090909;
  }
  .map-wrap iframe {
    width: 100%;
    height: 270px;
    border: 0;
    display: block;
    filter: grayscale(.18) contrast(1.08);
  }
  .price-groups {
    display: grid;
    gap: 16px;
    max-width: 660px;
    margin: 0 auto;
  }
  .price-group {
    border: 1px solid var(--line);
    background: rgba(255,255,255,.045);
    border-radius: 10px;
    padding: 16px;
  }
  .price-heading {
    font-family: "Cinzel", serif;
    color: var(--gold-bright);
    text-shadow: var(--glow);
    letter-spacing: .12em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .price-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted-strong);
    border-top: 1px solid rgba(255, 220, 145, .16);
    padding: 11px 0 0;
    margin-top: 11px;
    text-align: left;
  }
  .price-row span:last-child {
    color: var(--gold-bright);
    font-family: "Cinzel", serif;
    white-space: nowrap;
  }
  .gift-toggle {
    width: 100%;
    max-width: 440px;
    margin-top: 12px;
  }
  .gift-box,
  .transfer-box {
    display: none;
    max-width: 560px;
    margin: 14px auto 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px;
    background: rgba(0,0,0,.34);
    color: var(--muted-strong);
    line-height: 1.7;
  }
  .gift-box.visible,
  .transfer-box.visible { display: block; }
  .gallery-track {
    display: flex;
    overflow-x: auto;
    gap: 10px;
    padding: 2px 2px 8px;
    scroll-snap-type: x mandatory;
  }
  .gallery-item {
    flex: 0 0 72%;
    aspect-ratio: 4/5;
    border-radius: 9px;
    overflow: hidden;
    border: 2px solid var(--gold);
    background: #090909;
    cursor: pointer;
    scroll-snap-align: start;
    box-shadow: 0 14px 36px rgba(216, 180, 94, .17);
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .quote-text {
    font-family: "Cinzel", serif;
    font-style: italic;
    font-size: clamp(1.08rem, 4.6vw, 1.5rem);
    line-height: 1.8;
    color: var(--ink);
    margin: 0;
  }
  .rsvp-section {
    margin-top: 16px;
    padding: 30px 22px 34px;
  }
  .rsvp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .rsvp-field label {
    display: block;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .rsvp-field input,
  .rsvp-field select,
  .rsvp-field textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 11px 12px;
    font: inherit;
    font-size: .94rem;
    color: var(--ink);
    background: #080808;
  }
  .rsvp-field textarea {
    min-height: 78px;
    resize: vertical;
  }
  .guest-list {
    display: grid;
    gap: 12px;
  }
  .guest-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    border: 1px solid rgba(255, 220, 145, .22);
    border-radius: 10px;
    padding: 12px;
    background: rgba(255,255,255,.035);
  }
  .guest-row-title {
    font-family: "Cinzel", serif;
    color: var(--gold-bright);
    font-size: .78rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-align: left;
  }
  .full { grid-column: 1 / -1; }
  .send-btn {
    width: 100%;
    margin-top: 16px;
    padding: 14px;
  }
  .send-btn.is-loading {
    opacity: .78;
    pointer-events: none;
  }
  .rsvp-result {
    display: none;
    border: 1px solid var(--line);
    background: rgba(255,255,255,.05);
    border-radius: 12px;
    padding: 28px 18px;
    color: var(--ink);
  }
  .rsvp-result.visible { display: block; }
  .rsvp-spinner {
    display: inline-block;
    width: 30px;
    height: 30px;
    border: 2px solid rgba(255,255,255,.24);
    border-top-color: var(--gold-bright);
    border-radius: 50%;
    animation: spin .8s linear infinite;
    margin-bottom: 14px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0,0,0,.95);
  }
  .lightbox.visible { display: flex; }
  .lightbox img {
    max-width: 100%;
    max-height: 86vh;
    border-radius: 12px;
    box-shadow: 0 20px 70px rgba(216, 180, 94, .28);
  }
  .lightbox-close {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgba(255,255,255,.12);
    color: #fff;
    cursor: pointer;
    font-size: 1.3rem;
  }
  @media (min-width: 900px) {
    .page {
      max-width: 100%;
      padding: 30px 20px 84px;
    }
    .hero,
    .section-card,
    .rsvp-section {
      width: 45%;
      margin-left: auto;
      margin-right: auto;
    }
    .section-inner {
      padding: 52px 48px;
    }
    .grid { gap: 48px; }
    .gallery-track {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
    }
    .gallery-item { flex: 0 0 32%; }
    .map-wrap iframe { height: 380px; }
    .price-groups {
      grid-template-columns: 1fr;
      align-items: center;
      max-width: 430px;
    }
    .price-group { width: 100%; }
    #transfer-toggle { margin-top: 28px; }
    .rsvp-grid { gap: 22px; }
    .guest-row {
      grid-template-columns: 1fr;
      align-items: stretch;
      gap: 14px;
    }
    .guest-row-title { grid-column: 1 / -1; text-align: left; }
    .rsvp-field input,
    .rsvp-field select,
    .rsvp-field textarea {
      text-align: center;
      font-size: 1.04rem;
      padding: 14px 16px;
    }
  }
  @media (max-width: 520px) {
    .page { padding-left: 10px; padding-right: 10px; }
    .hero { min-height: 0; border-radius: 12px; }
    .hero-date {
      font-size: 1.15rem;
      margin-bottom: 2vh;
    }
    .hero-kicker {
      font-size: .78rem;
      margin-bottom: 8px;
    }
    .countdown { gap: 7px; }
    .count-box { padding: 11px 4px; }
    .rsvp-grid { grid-template-columns: 1fr; }
    .price-row { font-size: .98rem; }
  }
</style>
</head>
<body>
<%
  const heroLogo = event.hero_image || "/images/events/marta-70/hero-invitacion.png";
  const confirmLogo = "/images/GifDestellos.webp";
  const galleryImages = event.gallery && Array.isArray(event.gallery) && event.gallery.length
    ? event.gallery
    : [];
  const mapQuery = encodeURIComponent(
    event.custom_data?.map_embed_query ||
    `${event.venue_name || "Salon Centro Comercial"}, ${event.venue_address || "25 de Mayo 966, X5963 Villa del Rosario, Córdoba, Argentina"}`
  );
  const mapLink = event.maps_url || ("https://www.google.com/maps/search/?api=1&query=" + mapQuery);
  const eventDateForCalendar = event.date || "2026-08-22";
  const eventTimeForCalendar = event.time || "21:30";
  const startLocal = new Date(`${eventDateForCalendar}T${eventTimeForCalendar}:00`);
  const endLocal = new Date(startLocal.getTime() + 5 * 60 * 60 * 1000);
  const transfer = event.custom_data?.transfer_account || {};
  const priceGroups = event.custom_data?.price_groups || [];
  function toGoogleDate(d) {
    const yyyy = d.getUTCFullYear();
    const mm = String(d.getUTCMonth() + 1).padStart(2, "0");
    const dd = String(d.getUTCDate()).padStart(2, "0");
    const hh = String(d.getUTCHours()).padStart(2, "0");
    const mi = String(d.getUTCMinutes()).padStart(2, "0");
    const ss = String(d.getUTCSeconds()).padStart(2, "0");
    return `${yyyy}${mm}${dd}T${hh}${mi}${ss}Z`;
  }
  function formatDate(dateStr) {
    if (!dateStr) return "31 de julio de 2026";
    const date = new Date(dateStr + "T00:00:00");
    const months = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
    return `${date.getDate()} de ${months[date.getMonth()]} de ${date.getFullYear()}`;
  }
  const googleCalendarUrl =
    "https://calendar.google.com/calendar/render?action=TEMPLATE" +
    `&text=${encodeURIComponent(`70 A\u00f1os - ${event.honorees || "Marta"}`)}` +
    `&dates=${toGoogleDate(startLocal)}/${toGoogleDate(endLocal)}` +
    `&details=${encodeURIComponent("Te esperamos para celebrar juntos este dia especial.")}` +
    `&location=${encodeURIComponent(event.venue_address || event.venue_name || "")}`;
%>
  <main class="page">
    <header class="hero">
      <img class="hero-bg" src="<%= heroLogo %>" alt="Invitacion de 70 anos de Marta">
      <div class="hero-content">
        <div class="hero-kicker"></div>
        <div class="hero-date"></div>
      </div>
    </header>

    <section class="grid">
      <article class="section-card">
        <div class="section-inner">
          <h2 class="section-title">Cuenta regresiva</h2>
          <div class="section-divider"></div>
          <p class="section-sub">Cada segundo nos acerca a una noche inolvidable.</p>
          <div class="countdown" id="countdown" data-date="<%= event.date || "" %>" data-time="<%= event.time || "" %>">
            <div class="count-box"><span class="count-number" data-unit="days">--</span><span class="count-label">Dias</span></div>
            <div class="count-box"><span class="count-number" data-unit="hours">--</span><span class="count-label">Horas</span></div>
            <div class="count-box"><span class="count-number" data-unit="minutes">--</span><span class="count-label">Minutos</span></div>
            <div class="count-box"><span class="count-number" data-unit="seconds">--</span><span class="count-label">Segundos</span></div>
          </div>
          <a class="calendar-btn" href="<%= googleCalendarUrl %>" target="_blank" rel="noopener noreferrer">Agregar al calendario</a>
        </div>
      </article>

      <article class="section-card">
        <div class="section-inner">
          <img src="/images/GifDestellos.webp" alt="Destellos" class="section-icon">
          <h2 class="section-title">&iquest;Cu&aacute;ndo?</h2>
          <div class="section-divider"></div>
          <div class="info-list">
            <div><%= formatDate(event.date) %></div>
            <div><%= event.time || "21:30" %> hs</div>
          </div>
        </div>
      </article>

      <article class="section-card">
        <div class="section-inner">
          <img src="/images/GifMapa.webp" alt="Mapa" class="section-icon">
          <h2 class="section-title">&iquest;D&oacute;nde?</h2>
          <div class="section-divider"></div>
          <div class="info-list">
            <div><strong>Lugar:</strong> <%= event.venue_name || "Salon Centro Comercial" %></div>
            <div><strong>Direcci&oacute;n:</strong> <%= event.venue_address || "25 de Mayo 972, Villa el Rosario, Cordoba" %></div>
          </div>
        </div>
      </article>

      <% if (sections && sections.location) { %>
      <article class="section-card">
        <div class="section-inner">
          <img src="/images/GifMapa.webp" alt="Mapa" class="section-icon">
          <h2 class="section-title">C&oacute;mo llegar</h2>
          <div class="section-divider"></div>
          <div class="map-wrap">
            <iframe title="Mapa del evento" src="https://www.google.com/maps?q=<%= mapQuery %>&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
          <a class="map-btn" href="<%= mapLink %>" target="_blank" rel="noopener noreferrer">Abrir Google Maps</a>
        </div>
      </article>
      <% } %>

      <article class="section-card">
        <div class="section-inner">
          <img src="/images/GifRevista.webp" alt="Tarjeta" class="section-icon">
          <h2 class="section-title">Valor de la tarjeta</h2>
          <div class="section-divider"></div>
          <div class="price-groups">
            <% priceGroups.forEach(function(group) { %>
              <div class="price-group">
                <% if (group.title && group.title !== "Valor de la tarjeta") { %><h3 class="price-heading"><%= group.title %></h3><% } %>
                <% group.items.forEach(function(item) { %>
                  <div class="price-row"><span><%= item.label %></span><span><%= item.value %></span></div>
                <% }) %>
              </div>
            <% }) %>
          </div>
          <button type="button" class="gift-toggle" id="transfer-toggle">Ver datos para la transferencia</button>
          <div class="transfer-box" id="transfer-box"><div><strong>Alias:</strong> <%= transfer.alias || "DSEVENTOS" %></div></div>
        </div>
      </article>

      <% if (sections && sections.dress_code) { %>
      <article class="section-card">
        <div class="section-inner">
          <img src="/images/GifDiamante.webp" alt="Diamante" class="section-icon">
          <h2 class="section-title">Dress Code</h2>
          <div class="section-divider"></div>
          <div class="info-list">
            <div><strong><%= event.dress_code || "Glam Nocturno" %></strong></div>
          </div>
        </div>
      </article>
      <% } %>

      <% if (sections && sections.gallery) { %>
      <article class="section-card">
        <div class="section-inner">
          <img src="/images/GifCamara.webp" alt="Camara" class="section-icon">
          <h2 class="section-title">Galer&iacute;a</h2>
          <div class="section-divider"></div>
          <div class="gallery-track">
            <% galleryImages.forEach(function(photo) { %>
              <div class="gallery-item" data-photo="<%= photo %>">
                <img src="<%= photo %>" alt="Foto de galeria del evento">
              </div>
            <% }) %>
          </div>
        </div>
      </article>
      <% } %>

      <% if (event.custom_data?.show_quote) { %>
      <article class="section-card">
        <div class="section-inner">
          <img src="/images/GifStar.webp" alt="Estrella" class="section-icon">
          <div class="section-divider"></div>
          <p class="quote-text"><%= event.quote_message || "Fuerte y valiente para soñar, libre para vivir" %></p>
        </div>
      </article>
      <% } %>

      <% if (sections && sections.gifts) { %>
      <article class="section-card">
        <div class="section-inner">
          <img src="/images/GifRegalo.webp" alt="Regalo" class="section-icon">
          <h2 class="section-title">Regalo</h2>
          <div class="section-divider"></div>
          <p class="section-sub"><%= event.gift_message || "Con tu presencia alcanza, pero si deseas hacerme un regalo sera recibido con mucho amor." %></p>
          <button type="button" class="gift-toggle" id="gift-toggle">Ver datos para regalo</button>
          <div class="gift-box" id="gift-box">
            <div><strong>Alias:</strong> <%= giftAlias %></div>
            <div><strong>CBU:</strong> <%= giftCbu %></div>
            <div><strong>Titular:</strong> <%= event.gift_holder || "Ferreyra Laura Nadir" %></div>
            <div>Mercado Pago</div>
          </div>
        </div>
      </article>
      <% } %>
    </section>

    <section class="rsvp-section" id="rsvp">
      <div class="section-logo-wrap">
        <img src="<%= confirmLogo %>" alt="" class="section-logo-halo" aria-hidden="true">
        <img src="<%= confirmLogo %>" alt="Destellos" class="section-logo">
      </div>
      <h2 class="section-title">Confirmar asistencia</h2>
      <div class="section-divider"></div>
      <p class="section-sub">&iexcl;Quiero saber si vas a estar! Complet&aacute; tus datos ac&aacute; abajo.</p>
      <form action="/api/<%= event.slug %>/rsvp" method="post" id="rsvp-form">
        <div class="rsvp-grid">
          <input type="hidden" id="contact_name" name="contact_name" value="Confirmacion Marta">
          <textarea id="people_names" name="people_names" hidden></textarea>
          <textarea id="food_preferences" name="food_preferences" hidden></textarea>
          <div class="rsvp-field">
            <label for="people_count">&iquest;Cu&aacute;ntos vienen?</label>
            <input type="text" id="people_count" name="people_count" inputmode="numeric" pattern="[0-9]*" value="1" required>
          </div>
          <div class="rsvp-field">
            <label for="status">Asistencia</label>
            <select id="status" name="status">
              <option value="confirmed">Voy / Vamos</option>
              <option value="declined">No puedo ir</option>
            </select>
          </div>
          <div class="rsvp-field full" id="guest-details">
            <div class="guest-list" id="guest-list"></div>
          </div>
          <div class="rsvp-field full">
            <label for="comments">Comentarios</label>
            <textarea id="comments" name="comments" rows="3" placeholder="&#191;Alg&#250;n comentario?"></textarea>
          </div>
        </div>
        <button type="submit" class="send-btn">Enviar confirmaci&oacute;n</button>
      </form>
      <div class="rsvp-result" id="rsvp-result" aria-live="polite"></div>
    </section>
  </main>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightbox-close" aria-label="Cerrar">&times;</button>
    <img src="" alt="Foto ampliada de la galeria" id="lightbox-image">
  </div>

  <script>
    (function() {
      const qs = new URLSearchParams(window.location.search);
      if (qs.get("rsvp") === "ok") {
        qs.delete("rsvp");
        const clean = window.location.pathname + (qs.toString() ? "?" + qs.toString() : "");
        window.history.replaceState({}, "", clean);
        showRsvpResult(false);
      }

      const countdown = document.getElementById("countdown");
      if (countdown) {
        const dateStr = countdown.getAttribute("data-date");
        const timeStr = countdown.getAttribute("data-time") || "00:00";
        if (dateStr) {
          const target = new Date(dateStr + "T" + timeStr + ":00");
          function update() {
            const now = new Date();
            let diff = target.getTime() - now.getTime();
            if (diff < 0) diff = 0;
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const minutes = Math.floor((diff / (1000 * 60)) % 60);
            const seconds = Math.floor((diff / 1000) % 60);
            const set = function(unit, value) {
              const node = countdown.querySelector('[data-unit="' + unit + '"]');
              if (node) node.textContent = String(value).padStart(2, "0");
            };
            set("days", days);
            set("hours", hours);
            set("minutes", minutes);
            set("seconds", seconds);
          }
          update();
          setInterval(update, 1000);
        }
      }

      function bindToggle(buttonId, boxId, openText, closeText) {
        const button = document.getElementById(buttonId);
        const box = document.getElementById(boxId);
        if (!button || !box) return;
        button.addEventListener("click", function() {
          box.classList.toggle("visible");
          button.textContent = box.classList.contains("visible") ? closeText : openText;
        });
      }
      bindToggle("gift-toggle", "gift-box", "Ver datos para regalo", "Ocultar datos para regalo");
      bindToggle("transfer-toggle", "transfer-box", "Ver datos para la transferencia", "Ocultar datos para la transferencia");

      const rsvpForm = document.getElementById("rsvp-form");
      const peopleCount = document.getElementById("people_count");
      const guestList = document.getElementById("guest-list");
      const hiddenPeopleNames = document.getElementById("people_names");
      const hiddenFoodPreferences = document.getElementById("food_preferences");
      const hiddenContactName = document.getElementById("contact_name");
      const statusSelect = document.getElementById("status");
      const guestDetails = document.getElementById("guest-details");
      const rsvpResult = document.getElementById("rsvp-result");
      const sendBtn = rsvpForm ? rsvpForm.querySelector(".send-btn") : null;
      function getGuestValues() {
        if (!guestList) return [];
        return Array.from(guestList.querySelectorAll(".guest-row")).map(function(row) {
          const name = row.querySelector(".guest-name");
          const type = row.querySelector(".guest-type");
          const menu = row.querySelector(".guest-menu");
          return {
            name: name ? name.value.trim() : "",
            type: type ? type.value : "Mayor",
            menu: menu ? menu.value : "Menu estandar"
          };
        });
      }
      function menuOptions(type, selected) {
        const choices = type === "Menor"
          ? ["Menu infantil (Milanesas con papas fritas)"]
          : ["Menu estandar", "Vegetariano", "Celiaco"];
        return choices.map(function(choice) {
          return '<option value="' + choice + '"' + (choice === selected ? " selected" : "") + ">" + choice + "</option>";
        }).join("");
      }
      function renderGuestRows() {
        if (!peopleCount || !guestList) return;
        const current = getGuestValues();
        const digits = peopleCount.value.replace(/\D/g, "");
        if (peopleCount.value !== digits) peopleCount.value = digits;
        const total = Math.max(1, Math.min(30, Number(digits) || 1));
        if (Number(digits) > 30) peopleCount.value = "30";
        guestList.innerHTML = "";
        for (let index = 0; index < total; index++) {
          const previous = current[index] || {};
          const row = document.createElement("div");
          row.className = "guest-row";
          row.innerHTML =
            '<div class="guest-row-title">Invitado ' + (index + 1) + '</div>' +
            '<div class="rsvp-field">' +
              '<label>Nombre y apellido</label>' +
              '<input class="guest-name" type="text" required autocomplete="name" value="' + (previous.name || "").replace(/"/g, "&quot;") + '">' +
            '</div>' +
            '<div class="rsvp-field guest-type-field">' +
              '<label>Tipo de invitaci&oacute;n</label>' +
              '<select class="guest-type" required>' +
                '<option value="Mayor">Mayor</option>' +
                '<option value="Adolescente">Adolescente</option>' +
                '<option value="Menor">Menor</option>' +
                '<option value="Brindis">Brindis</option>' +
              '</select>' +
            '</div>';
          const type = row.querySelector(".guest-type");
          if (type && previous.type) type.value = previous.type;
          if (type) {
            const selectedType = previous.type === "Menor" ? "Menor" : "Mayor";
            type.innerHTML = '<option value="Mayor">Mayor</option><option value="Menor">Menor</option>';
            type.value = selectedType;
            const menuField = document.createElement("div");
            menuField.className = "rsvp-field guest-menu-field";
            menuField.innerHTML = '<label>Preferencia de comida</label><select class="guest-menu" required>' + menuOptions(selectedType, previous.menu || (selectedType === "Menor" ? "Menu infantil (Milanesas con papas fritas)" : "Menu estandar")) + '</select>';
            row.appendChild(menuField);
            type.addEventListener("change", function() {
              const menu = row.querySelector(".guest-menu");
              if (menu) menu.innerHTML = menuOptions(type.value, type.value === "Menor" ? "Menu infantil (Milanesas con papas fritas)" : "Menu estandar");
            });
          }
          guestList.appendChild(row);
        }
        updateGuestVisibility();
      }
      function normalizePeopleCount() {
        if (!peopleCount) return;
        const total = Math.max(1, Math.min(30, Number(peopleCount.value) || 1));
        peopleCount.value = String(total);
        renderGuestRows();
      }
      function syncGuestFields() {
        const guests = getGuestValues();
        const declined = statusSelect && statusSelect.value === "declined";
        if (hiddenPeopleNames) {
          hiddenPeopleNames.value = guests
            .filter(function(guest) { return guest.name; })
            .map(function(guest) { return declined ? guest.name : guest.name + " [ " + guest.type.toUpperCase() + " ]"; })
            .join("\n");
        }
        if (hiddenFoodPreferences) {
          hiddenFoodPreferences.value = declined ? "" : guests
            .filter(function(guest) { return guest.name; })
            .map(function(guest) { return guest.menu; })
            .join("\n");
        }
        if (hiddenContactName) {
          hiddenContactName.value = guests.find(function(guest) { return guest.name; })?.name || "Confirmacion Marta";
        }
      }
      function updateGuestVisibility() {
        const attending = !statusSelect || statusSelect.value !== "declined";
        if (guestDetails) guestDetails.hidden = false;
        if (!guestList) return;
        guestList.querySelectorAll(".guest-name").forEach(function(field) { field.disabled = false; });
        guestList.querySelectorAll(".guest-type-field, .guest-menu-field").forEach(function(field) { field.hidden = !attending; });
        guestList.querySelectorAll(".guest-type, .guest-menu").forEach(function(field) { field.disabled = !attending; });
      }
      if (peopleCount) {
        peopleCount.addEventListener("input", renderGuestRows);
        peopleCount.addEventListener("change", normalizePeopleCount);
        peopleCount.addEventListener("blur", normalizePeopleCount);
      }
      if (statusSelect) statusSelect.addEventListener("change", updateGuestVisibility);
      renderGuestRows();
      updateGuestVisibility();
      function showRsvpResult(loading) {
        if (!rsvpForm || !rsvpResult) return;
        rsvpForm.style.display = "none";
        rsvpResult.classList.add("visible");
        rsvpResult.innerHTML = loading
          ? '<span class="rsvp-spinner"></span><p class="section-sub" style="margin:0;">Enviando confirmacion...</p>'
          : '<h3 class="section-title" style="font-size:1.35rem;margin-bottom:10px;">Gracias por confirmar</h3><p class="section-sub" style="margin:0;">&iexcl;La vamos a pasar muy bien!</p>';
      }
      if (rsvpForm) {
        rsvpForm.addEventListener("submit", async function(e) {
          e.preventDefault();
          normalizePeopleCount();
          syncGuestFields();
          if (sendBtn) sendBtn.classList.add("is-loading");
          showRsvpResult(true);
          try {
            const response = await fetch(rsvpForm.action, {
              method: "POST",
              body: new URLSearchParams(new FormData(rsvpForm)),
              headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" }
            });
            if (!response.ok) throw new Error("No se pudo enviar");
            setTimeout(function() { showRsvpResult(false); }, 900);
          } catch (error) {
            rsvpForm.style.display = "";
            rsvpResult.classList.remove("visible");
            rsvpResult.innerHTML = "";
            if (sendBtn) sendBtn.classList.remove("is-loading");
            window.alert("No pudimos enviar la confirmacion. Intenta nuevamente.");
          }
        });
      }

      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxClose = document.getElementById("lightbox-close");
      document.querySelectorAll(".gallery-item").forEach(function(item) {
        item.addEventListener("click", function() {
          const photo = item.getAttribute("data-photo");
          if (!photo || !lightbox || !lightboxImage) return;
          lightboxImage.src = photo;
          lightbox.classList.add("visible");
        });
      });
      if (lightboxClose && lightbox) {
        lightboxClose.addEventListener("click", function() {
          lightbox.classList.remove("visible");
        });
        lightbox.addEventListener("click", function(e) {
          if (e.target === lightbox) lightbox.classList.remove("visible");
        });
      }
    })();
  </script>
</body>
</html>
